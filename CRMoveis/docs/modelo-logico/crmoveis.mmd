%% SP_Imoveis_CRM — modelo lógico (Chen -> ER)
%% Cole em https://mermaid.live, no Miro (app Mermaid / diagrama como código), GitHub ou Notion.
erDiagram
  direction LR   %% fluxo da esquerda (pessoas) para a direita (contrato e financeiro); remova esta linha se a sua ferramenta reclamar
  usuarios ||--o{ usuario_telefones : "usuario_id"
  usuarios ||--o{ perfis_interesse : "usuario_id"
  usuarios |o--o{ imoveis : "corretor_responsavel_id"
  usuarios ||--o{ imoveis : "proprietario_id"
  imoveis ||--o{ imovel_fotos : "imovel_id"
  imoveis ||--o{ imovel_caracteristicas : "imovel_id"
  caracteristicas ||--o{ imovel_caracteristicas : "caracteristica_id"
  imoveis ||--o{ conversa_imoveis : "imovel_id"
  conversas ||--o{ conversa_imoveis : "conversa_id"
  imoveis ||--o{ visitas : "imovel_id"
  usuarios ||--o{ visitas : "cliente_id"
  usuarios ||--o{ visitas : "corretor_id"
  imoveis ||--o{ propostas : "imovel_id"
  usuarios ||--o{ propostas : "cliente_id"
  usuarios ||--o{ propostas : "corretor_id"
  visitas |o--o{ propostas : "visita_id"
  propostas ||--o| contratos : "proposta_id"
  contratos ||--o{ contrato_documentos : "contrato_id"
  contratos ||--o{ comissoes : "contrato_id"
  usuarios ||--o{ comissoes : "corretor_id"
  usuarios ||--o{ conversas : "cliente_id"
  funil_estagios ||--o{ conversas : "estagio_id"
  usuarios |o--o{ conversas : "corretor_id"
  conversas ||--o{ historico_estagios : "conversa_id"
  funil_estagios ||--o{ historico_estagios : "estagio_novo_id"
  funil_estagios |o--o{ historico_estagios : "estagio_anterior_id"
  usuarios |o--o{ historico_estagios : "usuario_id"
  conversas ||--o{ mensagens : "conversa_id"
  conversas |o--o{ tarefas : "conversa_id"
  usuarios ||--o{ tarefas : "corretor_id"
  tags ||--o{ conversa_tags : "tag_id"
  conversas ||--o{ conversa_tags : "conversa_id"
  contratos ||--o| financiamentos : "contrato_id"
  contratos |o--o{ contas_receber : "contrato_id"
  financiamentos |o--o{ contas_receber : "financiamento_id"
  categorias_financeiras ||--o{ contas_receber : "categoria_id"
  usuarios |o--o{ contas_receber : "pagador_id"
  contratos |o--o{ contas_pagar : "contrato_id"
  categorias_financeiras ||--o{ contas_pagar : "categoria_id"
  usuarios |o--o{ contas_pagar : "favorecido_id"
  usuarios |o--o{ contas_pagar : "pagador_id"
  contas_pagar |o--o| comissoes : "conta_pagar_id"
  contas_receber ||--o{ recebimentos : "conta_receber_id"
  contas_bancarias ||--o{ recebimentos : "conta_bancaria_id"
  contas_pagar ||--o{ pagamentos : "conta_pagar_id"
  contas_bancarias ||--o{ pagamentos : "conta_bancaria_id"
  conversas ||--o{ automation_runs : "conversa_id"
  automation_runs ||--o{ automation_logs : "nr_execucao"

  %% ---------- Pessoas ----------
  %% usuarios: entidade forte  |  CHECK(e_cliente OR e_proprietario OR e_corretor OR e_fornecedor OR e_admin)
  usuarios {
    int id PK
    text nome "obrigatorio"
    text documento UK
    text email UK
    text senha_hash
    text creci UK
    enum origem "site, indicacao, portal, instagram, whatsapp, interno"
    boolean e_cliente "obrigatorio"
    boolean e_proprietario "obrigatorio"
    boolean e_corretor "obrigatorio"
    boolean e_fornecedor "obrigatorio"
    boolean e_admin "obrigatorio"
    text observacoes
    boolean ativo
    datetime created_at
  }
  %% usuario_telefones: entidade fraca
  usuario_telefones {
    int usuario_id PK FK
    int nr_telefone PK
    text numero UK "obrigatorio"
    enum tipo "celular, whatsapp, fixo"
    boolean principal
  }
  %% perfis_interesse: entidade fraca
  perfis_interesse {
    int usuario_id PK FK
    int nr_perfil PK
    enum finalidade "venda, locacao"
    enum tipo_imovel "..."
    text cidade
    text bairro
    decimal valor_min
    decimal valor_max
    int quartos_min
    datetime created_at
  }

  %% ---------- Imóveis ----------
  %% imoveis: entidade forte
  imoveis {
    int id PK
    text codigo_imobizi UK
    int proprietario_id FK "obrigatorio"
    int corretor_responsavel_id FK
    enum tipo "apartamento, casa, terreno, comercial, rural"
    enum finalidade "venda, locacao"
    text logradouro
    text numero
    text complemento
    text bairro
    text cidade
    char uf
    char cep
    decimal area_util
    decimal area_total
    int quartos
    int banheiros
    int vagas_garagem
    decimal valor
    enum status "disponivel, reservado, vendido, alugado, inativo"
    text descricao
    datetime created_at
    datetime updated_at
  }
  %% imovel_fotos: entidade fraca
  imovel_fotos {
    int imovel_id PK FK
    int ordem PK
    text url "obrigatorio"
    datetime created_at
  }
  %% caracteristicas: entidade forte
  caracteristicas {
    int id PK
    text nome UK "obrigatorio"
  }
  %% imovel_caracteristicas: entidade associativa
  imovel_caracteristicas {
    int caracteristica_id PK FK
    int imovel_id PK FK
  }
  %% conversa_imoveis: entidade associativa
  conversa_imoveis {
    int imovel_id PK FK
    int conversa_id PK FK
    datetime created_at
  }

  %% ---------- Funil / CRM ----------
  %% conversas: entidade forte
  conversas {
    int id PK
    int cliente_id FK "obrigatorio"
    int corretor_id FK
    int estagio_id FK "obrigatorio"
    text notas
    datetime created_at
    datetime updated_at
  }
  %% mensagens: entidade fraca
  mensagens {
    int id PK
    int conversa_id FK "obrigatorio"
    enum direcao "entrada, saida"
    enum canal "whatsapp, email, nota_interna"
    text corpo
    datetime created_at
  }
  %% tags: entidade forte
  tags {
    int id PK
    text nome UK "obrigatorio"
  }
  %% conversa_tags: entidade associativa
  conversa_tags {
    int conversa_id PK FK
    int tag_id PK FK
  }
  %% funil_estagios: entidade forte
  funil_estagios {
    int id PK
    text nome UK "obrigatorio"
    int ordem "obrigatorio"
    text cor
    datetime created_at
  }
  %% historico_estagios: entidade fraca
  historico_estagios {
    int conversa_id PK FK
    datetime alterado_em PK
    int estagio_anterior_id FK
    int estagio_novo_id FK "obrigatorio"
    int usuario_id FK
  }
  %% tarefas: entidade forte
  tarefas {
    int id PK
    int conversa_id FK
    int corretor_id FK "obrigatorio"
    text titulo "obrigatorio"
    text descricao
    datetime data_vencimento
    enum status "pendente, concluida, cancelada"
    datetime created_at
  }

  %% ---------- Negociação ----------
  %% visitas: entidade associativa  |  UNIQUE(imovel_id, cliente_id, data_hora)
  visitas {
    int id PK
    int imovel_id FK "obrigatorio"
    int cliente_id FK "obrigatorio"
    int corretor_id FK "obrigatorio"
    datetime data_hora "obrigatorio"
    enum status "agendada, realizada, cancelada"
    text feedback
    datetime created_at
  }
  %% propostas: entidade associativa
  propostas {
    int id PK
    int imovel_id FK "obrigatorio"
    int cliente_id FK "obrigatorio"
    int corretor_id FK "obrigatorio"
    int visita_id FK
    decimal valor_proposto "obrigatorio"
    text condicoes
    enum status "pendente, aceita, recusada, contraproposta"
    datetime created_at
    datetime updated_at
  }
  %% contratos: entidade forte
  contratos {
    int id PK
    int proposta_id FK UK "obrigatorio"
    enum tipo "venda, locacao"
    enum forma_pagamento "a_vista, financiado, parcelado_direto"
    decimal valor_final "obrigatorio"
    date data_assinatura
    date data_fim
    enum status "vigente, encerrado, cancelado"
    datetime created_at
  }
  %% contrato_documentos: entidade fraca
  contrato_documentos {
    int contrato_id PK FK
    int nr_documento PK
    text nome
    text url "obrigatorio"
    datetime created_at
  }
  %% comissoes: entidade forte
  comissoes {
    int contrato_id PK FK
    int corretor_id PK FK
    decimal percentual "obrigatorio"
    decimal valor "derivado"
    enum regra_pagamento "na_assinatura, na_liberacao_credito, no_recebimento"
    enum status_pagamento "pendente, liberada, paga, cancelada"
    int conta_pagar_id FK UK
  }

  %% ---------- Financeiro ----------
  %% financiamentos: especializacao
  financiamentos {
    int contrato_id PK FK
    text instituicao "obrigatorio"
    decimal valor_financiado "obrigatorio"
    decimal valor_entrada
    int nr_parcelas
    decimal taxa_juros_aa
    enum status "em_analise, aprovado, reprovado, liberado, cancelado"
    date dt_aprovacao
    date dt_liberacao
    datetime created_at
  }
  %% categorias_financeiras: entidade forte
  categorias_financeiras {
    int id PK
    text nome UK "obrigatorio"
    enum tipo "obrigatorio, receita, despesa"
  }
  %% contas_bancarias: entidade forte
  contas_bancarias {
    int id PK
    text apelido UK "obrigatorio"
    text instituicao
    enum tipo "corrente, poupanca, caixa"
    boolean ativa
  }
  %% contas_receber: entidade forte
  contas_receber {
    int id PK
    int financiamento_id FK
    int contrato_id FK
    int categoria_id FK "obrigatorio"
    int pagador_id FK
    enum responsavel "obrigatorio, cliente, inquilino, proprietario, banco"
    enum origem "obrigatorio, corretagem, intermediacao, administracao, aluguel, servico"
    text descricao
    date competencia
    decimal valor "obrigatorio"
    date vencimento "obrigatorio"
    enum status "previsto, parcial, recebido, atrasado, cancelado"
    datetime created_at
  }
  %% recebimentos: entidade fraca
  recebimentos {
    int conta_receber_id PK FK
    int nr_recebimento PK
    int conta_bancaria_id FK "obrigatorio"
    date data_recebimento "obrigatorio"
    decimal valor "obrigatorio"
    enum forma "pix, ted, boleto, dinheiro, cartao"
  }
  %% contas_pagar: entidade forte
  contas_pagar {
    int id PK
    int contrato_id FK
    int categoria_id FK "obrigatorio"
    int favorecido_id FK
    int pagador_id FK
    enum responsavel "obrigatorio, imobiliaria, proprietario, inquilino"
    enum tipo "obrigatorio, comissao, repasse_proprietario, despesa, imposto"
    text descricao
    date competencia
    decimal valor "obrigatorio"
    date vencimento "obrigatorio"
    enum status "previsto, parcial, pago, atrasado, cancelado"
    datetime created_at
  }
  %% pagamentos: entidade fraca
  pagamentos {
    int conta_pagar_id PK FK
    int nr_pagamento PK
    int conta_bancaria_id FK "obrigatorio"
    date data_pagamento "obrigatorio"
    decimal valor "obrigatorio"
    enum forma "pix, ted, boleto, dinheiro, cartao"
  }

  %% ---------- Integração N8N ----------
  %% automation_runs: entidade fraca  |  UNIQUE(conversa_id, demand_hash)
  automation_runs {
    int conversa_id PK FK
    int nr_execucao PK
    text demand_hash "obrigatorio"
    text status
    json demand_json
    json selector_json
    json dispatch_json
    text message
    text error
    datetime created_at
    datetime updated_at
    datetime sent_at
  }
  %% automation_logs: entidade fraca
  automation_logs {
    int conversa_id PK FK
    int nr_execucao PK FK
    int nr_log PK
    text event
    text message
    json payload_json
    datetime created_at
  }
