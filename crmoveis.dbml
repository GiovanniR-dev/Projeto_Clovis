Ref: conversa_imovel.id_conversa > conversa.id_conversa // INTERESSA
Ref: mensagem.id_conversa > conversa.id_conversa // CONTEM
Ref: historico_estagio.id_conversa > conversa.id_conversa // MOVE
Ref: historico_estagio.id_estagio > funil_estagio.id_estagio // MOVE
Ref: historico_estagio.id_usuario > usuario.id_usuario // REGISTRA
Ref: tarefa.id_conversa > conversa.id_conversa // GERA TAREFA
Ref: tarefa.id_corretor > usuario.id_usuario // EXECUTA
Ref: conversa_tag.id_conversa > conversa.id_conversa // MARCA
Ref: conversa_tag.id_tag > tag.id_tag // MARCA
Ref: visita.id_imovel > imovel.id_imovel // VISITA
Ref: visita.id_cliente > usuario.id_usuario // VISITA
Ref: visita.id_corretor > usuario.id_usuario // ACOMPANHA
Ref: proposta.id_imovel > imovel.id_imovel // PROPOE
Ref: proposta.id_cliente > usuario.id_usuario // PROPOE
Ref: proposta.id_corretor > usuario.id_usuario // NEGOCIA
Ref: proposta.id_autorizador > usuario.id_usuario // AUTORIZA
Ref: proposta.id_proposta_respondida - proposta.id_proposta // RESPONDE
Ref: proposta.id_visita > visita.id_visita // ORIGINA
Ref: contrato.id_proposta - proposta.id_proposta // FECHA
Ref: documento.id_contrato > contrato.id_contrato // ANEXA
Ref: comissao.id_contrato > contrato.id_contrato // RECEBE
Ref: comissao.id_corretor > usuario.id_usuario // RECEBE
Ref: comissao.id_aprovador > usuario.id_usuario // APROVA
Ref: comissao.id_conta_pagar - conta_pagar.id_conta_pagar // LANCA
Ref: financiamento.id_contrato - contrato.id_contrato // FINANCIA
Ref: financiamento.id_instituicao > usuario.id_usuario // CONCEDE
Ref: conta_receber.id_contrato > contrato.id_contrato // GERA RECEITA
Ref: conta_receber.id_categoria > categoria_financeira.id_categoria // CLASSIFICA
Ref: conta_receber.id_pagador > usuario.id_usuario // PAGA
Ref: recebimento.id_conta_receber > conta_receber.id_conta_receber // QUITA
Ref: recebimento.id_conta > conta_bancaria.id_conta // CREDITA
Ref: conta_pagar.id_contrato > contrato.id_contrato // GERA DESPESA
Ref: conta_pagar.id_categoria > categoria_financeira.id_categoria // CATEGORIZA
Ref: conta_pagar.id_favorecido > usuario.id_usuario // FAVORECE
Ref: conta_pagar.id_custeador > usuario.id_usuario // CUSTEIA
Ref: pagamento.id_conta_pagar > conta_pagar.id_conta_pagar // LIQUIDA
Ref: pagamento.id_conta > conta_bancaria.id_conta // DEBITA
Ref: pagamento.id_usuario > usuario.id_usuario // EFETIVA
Ref: automacao_execucao.id_conversa > conversa.id_conversa // DISPARA
Ref: automacao_log.(id_conversa, nr_execucao) > automacao_execucao.(id_conversa, nr_execucao) // GRAVA
Ref: auditoria.id_usuario > usuario.id_usuario // PRATICA
Ref: auditoria_campo.id_auditoria > auditoria.id_auditoria // DETALHA
